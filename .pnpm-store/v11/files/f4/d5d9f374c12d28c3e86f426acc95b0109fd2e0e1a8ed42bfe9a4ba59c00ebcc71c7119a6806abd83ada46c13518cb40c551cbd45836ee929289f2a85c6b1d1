:root {
  --mediaplayer-color: #ffffff;
  --mediaplayer-background: #000000;
  --mediaplayer-error-color: #ffffff;
  --mediaplayer-error-background: #ff0000;
  --big-play-button-color: #ffffff;
  --big-play-button-background: #90a4ae;
  --big-play-button-border: #ffffff 1px solid;
  --big-play-button-border-hover: #ffffff 1px solid;
  --big-play-button-hover-color: #90a4ae;
  --big-play-button-hover-background: rgba(255, 255, 255, 0.2);
  --mediaplayer-color-dark: #c0c0c0;
  --mediaplayer-background-dark: #1d1d1d;
  --mediaplayer-error-color-dark: #ffffff;
  --mediaplayer-error-background-dark: #ff0000;
  --big-play-button-color-dark: #ffffff;
  --big-play-button-background-dark: #90a4ae;
  --big-play-button-border-dark: #ffffff 1px solid;
  --big-play-button-border-hover-dark: #ffffff 1px solid;
  --big-play-button-hover-color-dark: #90a4ae;
  --big-play-button-hover-background-dark: rgba(255, 255, 255, 0.2);
}

.q-media {
  position: relative;
  min-width: 230px !important;
  min-height: 40px !important;
  overflow: hidden !important;
  display: flex;
  flex-direction: column;
  background: var(--mediaplayer-background);
  color: var(--mediaplayer-color);
}
.q-media--player {
  width: 100%;
  height: 100%;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media--player--bottom-controls--standard {
  height: calc(100vh - 80px);
}
.q-media--player--bottom-controls--dense {
  height: calc(100vh - 40px);
}
.q-media__audio--standard {
  width: 100%;
  height: 80px !important;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media__audio--dense {
  width: 100%;
  height: 40px !important;
  vertical-align: bottom;
  align-self: flex-end;
}
.q-media__error-window {
  position: absolute;
  right: 0;
  top: 0;
  left: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40px;
  font-size: 0.8rem;
  text-align: center;
  background: var(--mediaplayer-error-background);
  color: var(--mediaplayer-error-color);
  transition: height 250ms ease-in;
}
.q-media__error-window--button {
  position: absolute;
  left: 0;
  top: 0;
}
.q-media__overlay-window {
  position: absolute;
  right: 0;
  top: 0;
  left: 0;
  height: auto;
  background: transparent;
  z-index: 1;
}
.q-media__loading--video {
  position: absolute;
  right: 50%;
  margin-right: -1.5rem;
  top: 50%;
  margin-bottom: -1.5rem;
  width: 3rem;
  height: 3rem;
  color: white;
  background: transparent;
}
.q-media__loading--audio {
  position: absolute;
  right: 50%;
  margin-right: -0.5rem;
  top: 50%;
  margin-bottom: -0.5rem;
  width: 1.5rem;
  height: 1.5rem;
  color: white;
  background: transparent;
}
.q-media--big-button {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  right: 50%;
  top: 50%;
  transform: translate(50%, -50%);
  width: 3rem;
  height: 3rem;
  cursor: pointer;
  border-radius: 1.5rem;
  opacity: 1;
  font-size: 3rem;
  z-index: 1000;
  background: var(--big-play-button-background);
  color: var(--big-play-button-color);
  border: var(--big-play-button-border);
  transition: all 200ms ease-in;
  transition-property: color, background, border;
}
.q-media--big-button:hover {
  color: var(--big-play-button-hover-color) !important;
  background: var(--big-play-button-hover-background) !important;
  border: var(--big-play-button-border-hover) !important;
}
.q-media--big-button-icon {
  position: relative;
  font-size: 2rem;
}
.q-media__controls {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  z-index: 2;
}
.q-media__controls--overlay {
  background: rgba(0, 0, 0, 0.4);
}
.q-media__controls--bottom-controls {
  position: relative !important;
}
.q-media__controls--row {
  height: 40px;
}
.q-media__controls--standard {
  height: 80px !important;
  transition: height 250ms ease-in;
  z-index: 2;
}
.q-media__controls--dense {
  height: 40px !important;
  transition: height 250ms ease-in;
  z-index: 2;
}
.q-media__controls--hidden {
  height: 0 !important;
  transition: height 250ms ease-out;
}
.q-media__controls--button {
  max-width: 40px !important;
  min-width: 40px !important;
  max-height: 40px !important;
  min-height: 40px !important;
}
.q-media__controls--volume-box {
  max-height: 40px !important;
  min-height: 40px !important;
}
.q-media__controls--video-time-text {
  min-width: 50px;
  padding: 0 0.25rem;
  font-size: 0.8rem;
  text-align: center;
}
.q-media__controls--video-slider {
  padding: 0 4px;
}
.q-media__fullscreen {
  z-index: 5900;
}
.q-media__fullscreen--window {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  height: 100vh !important;
  width: 100vw !important;
  max-height: 100vh !important;
  max-width: 100vw !important;
  overflow: hidden;
}

.q-dark div.q-media,
.body--dark div.q-media,
.q-media--dark.q-media {
  background: var(--mediaplayer-background-dark);
  color: var(--mediaplayer-color-dark);
}
.q-dark div.q-media--big-button,
.body--dark div.q-media--big-button,
.q-media--dark.q-media--big-button {
  background: var(--big-play-button-background-dark);
  color: var(--big-play-button-color-dark);
  border: var(--big-play-button-border-dark);
}
.q-dark div.q-media--big-button:hover,
.body--dark div.q-media--big-button:hover,
.q-media--dark.q-media--big-button:hover {
  color: var(--big-play-button-hover-color-dark) !important;
  background: var(--big-play-button-hover-background-dark) !important;
  border: var(--big-play-button-border-hover-dark) !important;
}
.q-dark div.q-media__error-window,
.body--dark div.q-media__error-window,
.q-media--dark.q-media__error-window {
  background: var(--mediaplayer-error-background-dark);
  color: var(--mediaplayer-error-color-dark);
}